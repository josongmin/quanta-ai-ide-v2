{
  "name": "quanta-ai-ide-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev",
    "storybook:build": "storybook build",
    "test:renderer": "playwright test",
    "test:tauri": "wdio run wdio.conf.ts",
    "verify:ui": "pnpm ui-infra:audit && pnpm storybook:build && pnpm test:renderer",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "ui-infra:audit": "node scripts/ui-infra-audit.mjs",
    "ui-infra:update": "node scripts/ui-infra-audit.mjs --update",
    "test:ui-infra-audit": "node --test scripts/ui-infra-audit.test.mjs",
    "test:workbench": "vitest run src/shared/workbench",
    "audit:cross-slice": "node scripts/audit-cross-slice.mjs",
    "catalog:validate": "PYTHONPATH=tools/feature-catalog/src python -m feature_catalog validate --root tools/feature-catalog/catalog",
    "catalog:audit": "PYTHONPATH=tools/feature-catalog/src python -m feature_catalog audit --root tools/feature-catalog/catalog",
    "catalog:render": "PYTHONPATH=tools/feature-catalog/src python -m feature_catalog render --root tools/feature-catalog/catalog --format md",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:deps": "knip --dependencies",
    "deps:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "semgrep": "semgrep --config .semgrep.yml --metrics=off",
    "semgrep:strict": "semgrep --config .semgrep.yml --metrics=off --error",
    "semgrep:registry": "semgrep --config p/typescript --config p/react --config p/javascript --config p/security-audit --metrics=off",
    "semgrep:ci": "semgrep --config .semgrep.yml --config p/typescript --config p/react --config p/security-audit --metrics=off --severity=ERROR --error",
    "verify": "pnpm typecheck && pnpm i18n:audit && pnpm lint:strict && pnpm semgrep:ci && pnpm ui-infra:audit && pnpm catalog:validate && pnpm test && pnpm build && pnpm bundle-budget",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.2",
    "@tauri-apps/api": "^2.11.0",
    "better-auth": "^1.6.23",
    "i18next": "^26.0.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.479.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "three": "^0.160.0",
    "zod": "4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.9",
    "@wdio/cli": "9.30.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-service": "1.2.0",
    "@wdio/types": "9.29.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.12.1",
    "madge": "^8.0.0",
    "mocha": "11.7.6",
    "postcss": "^8.4.49",
    "storybook": "10.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "webdriverio": "9.30.0"
  }
}
