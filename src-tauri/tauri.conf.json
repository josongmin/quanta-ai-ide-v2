{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quanta-ai-ide-v2",
  "version": "0.1.0",
  "identifier": "com.sedotfield.demo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "2.5D Code City",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "2.5D Code City — interactive code-base visualization",
    "longDescription": "Visualize a code-base as a 2.5D city with feature/file dot fields, filters, and design tokens.",
    "copyright": "Copyright © 2026 quanta-ai-ide-v2",
    "homepage": "https://github.com/sedotfield/demo",
    "publisher": "quanta-ai-ide-v2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
