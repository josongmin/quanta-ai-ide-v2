# Backend integration config (Vite build-time env — read via src/shared/config/env.ts).
# Copy to `.env.local` and fill in once a real backend exists.

# Leave unset (or VITE_API_MODE=mock) to run fully on in-app mock generators.
# Set both to point the app at a real REST backend.
VITE_API_MODE=mock
# VITE_API_BASE_URL=https://api.example.com
