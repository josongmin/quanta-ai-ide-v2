# Backend integration config (Vite build-time env — read via src/shared/config/env.ts).
# Copy to `.env.local` and fill in once a real backend exists.

# Leave unset (or VITE_API_MODE=mock) to run fully on in-app mock generators.
# Set both to point the app at a real REST backend.
VITE_API_MODE=mock
# VITE_API_BASE_URL=https://api.example.com

# ── Auth (accounts / better-auth) ─────────────────────────────────────────
# Leave mock to run the standalone demo (stub sign-in, no route guards).
# Set BOTH to wire real login + org/account/billing against the accounts
# backend (better-auth). Real mode drives the org-stage/me-stage/billing/
# onboarding real paths and the /accept-invitation + /billing/{success,cancel}
# landing routes.
VITE_AUTH_MODE=mock
# VITE_ACCOUNTS_URL=http://localhost:4000
#
# Live smoke checklist (real mode):
#   FE:       VITE_AUTH_MODE=real  VITE_ACCOUNTS_URL=http://localhost:4000
#   accounts: TRUSTED_ORIGINS=http://localhost:5173   (CORS + better-auth CSRF —
#             cross-origin calls SILENTLY fail if unset)
#             APP_URL=http://localhost:5173            (Stripe return + invite
#             accept links land on the FE, not the backend origin)
#             DATABASE_URL, BETTER_AUTH_SECRET, and (for checkout) STRIPE_SECRET_KEY
#             + STRIPE_PRICE_* ; (for OAuth) GITHUB_/GOOGLE_CLIENT_ID+SECRET
