{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".claude/**",
    "src-tauri/**",
    "dist/**",
    "scripts/**"
  ],
  "entry": [
    "src/main.tsx",
    "src/app/App.tsx",
    "src/app/router/router.tsx",
    "src/app/router/workspaceTabsRegistry.tsx",
    "src/app/providers/AppProviders.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "tailwind.config.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@tauri-apps/plugin-shell"
  ],
  "ignoreBinaries": [
    "python3",
    "semgrep"
  ]
}
