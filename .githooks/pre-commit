#!/usr/bin/env sh
# Lightweight pre-commit hook (no Node-based hook manager).
#
# Auto-enabled on `pnpm install` via package.json's `prepare` script
# (sets core.hooksPath to .githooks). To disable locally:
#   git config --unset core.hooksPath
#
# Kept intentionally fast: typecheck + lint only, so committing stays
# snappy. semgrep (which fetches remote rule registries and takes
# minutes) runs in CI, not here.

set -e

echo "[pre-commit] pnpm typecheck"
pnpm typecheck

echo "[pre-commit] pnpm lint"
pnpm lint
