#!/usr/bin/env sh
# Lightweight pre-commit hook (no Node-based hook manager).
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -e

echo "[pre-commit] pnpm typecheck"
pnpm typecheck

echo "[pre-commit] pnpm lint"
pnpm lint

echo "[pre-commit] pnpm semgrep:ci"
pnpm semgrep:ci
